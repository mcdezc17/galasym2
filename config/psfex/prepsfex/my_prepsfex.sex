# Simple configuration file for SExtractor prior to PSFEx use
# only non-default parameters are present.
# FOR GALASYM2 ANALYSIS IMG: A496J.fits
# DATE 190925

#-------------------------------- Catalog ------------------------------------

CATALOG_NAME    data/results_psfex/prepsfex.cat
CATALOG_TYPE     FITS_LDAC
PARAMETERS_NAME  config/psfex/prepsfex/prepsfex.param

#------------------------------- Extraction ----------------------------------

DETECT_MINAREA   3
DETECT_THRESH    4
ANALYSIS_THRESH  4

FILTER           Y
FILTER_NAME      config/psfex/prepsfex/default.conv

#-------------------------------- WEIGHTing ----------------------------------
#-------------------------------- FLAGging -----------------------------------
#------------------------------ Photometry -----------------------------------

PHOT_FLUXFRAC  0.5

PHOT_APERTURES  17.
SATUR_LEVEL     295977.
MAG_ZEROPOINT   30.
GAIN            6.11
