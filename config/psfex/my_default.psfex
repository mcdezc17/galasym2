# Default configuration file for PSFEx 3.9.0
# FOR GALASYM ANALYSIS IMG: A496J.fits
# DATE 190925

#-------------------------------- PSF model ----------------------------------

BASIS_TYPE      PIXEL_AUTO
BASIS_NUMBER    20
PSF_SAMPLING    0.0
PSF_ACCURACY    0.01
PSF_SIZE        25,25
CENTER_KEYS     X_IMAGE,Y_IMAGE
PHOTFLUX_KEY    FLUX_APER(1)
PHOTFLUXERR_KEY FLUXERR_APER(1)

#----------------------------- PSF variability -----------------------------

PSFVAR_KEYS     X_IMAGE,Y_IMAGE
PSFVAR_GROUPS   1,1
PSFVAR_DEGREES  2

#----------------------------- Sample selection ------------------------------

SAMPLE_AUTOSELECT    Y
SAMPLEVAR_TYPE       SEEING
SAMPLE_FWHMRANGE     2.0,10.0
SAMPLE_VARIABILITY   0.2
SAMPLE_MINSN         20
SAMPLE_MAXELLIP      0.3

#------------------------------- Check-plots ----------------------------------

CHECKPLOT_DEV       PNG

CHECKPLOT_RES       0
CHECKPLOT_ANTIALIAS Y
CHECKPLOT_TYPE      FWHM,ELLIPTICITY,COUNTS,COUNT_FRACTION,CHI2,RESIDUALS # or NONE
CHECKPLOT_NAME      data/results_psfex/fwhm.png, data/results_psfex/ellipticity.png, data/results_psfex/counts.png, data/results_psfex/countfrac.png, data/results_psfex/chi2.png, data/results_psfex/resi.png

#------------------------------ Check-Images ---------------------------------

CHECKIMAGE_TYPE CHI,PROTOTYPES,SAMPLES,RESIDUALS,SNAPSHOTS,MOFFAT,-MOFFAT,-SYMMETRICAL

CHECKIMAGE_NAME data/results_psfex/chi.fits, data/results_psfex/proto.fits, data/results_psfex/samp.fits, data/results_psfex/resi.fits, data/results_psfex/snap.fits, data/results_psfex/moffat.fits, data/results_psfex/submoffat.fits, data/results_psfex/subsym.fits

#----------------------------- Miscellaneous ---------------------------------

PSF_DIR         data/results_psfex
PSF_SUFFIX      .psf
VERBOSE_TYPE    NORMAL
WRITE_XML       Y
XML_NAME        data/results_psfex/psfex.xml
NTHREADS        0
