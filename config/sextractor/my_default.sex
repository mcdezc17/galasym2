# Default configuration file for SExtractor 2.28.0
# FOR GALASYM ANALYSIS IMG: A496J.fits

#-------------------------------- Catalog ------------------------------------

CATALOG_NAME data/results_sex/test.cat
CATALOG_TYPE ASCII_HEAD

PARAMETERS_NAME config/sextractor/default.param

#------------------------------- Extraction ----------------------------------

DETECT_TYPE CCD
DETECT_MINAREA 5
DETECT_MAXAREA 0
THRESH_TYPE RELATIVE

DETECT_THRESH 1.
ANALYSIS_THRESH 1.

FILTER Y
FILTER_NAME config/sextractor/gauss_2.0_3x3.conv
FILTER_THRESH

DEBLEND_NTHRESH 32
DEBLEND_MINCONT 0.005

CLEAN Y
CLEAN_PARAM 1.0

MASK_TYPE CORRECT

#-------------------------------- WEIGHTing ----------------------------------

WEIGHT_TYPE NONE

RESCALE_WEIGHTS Y
WEIGHT_IMAGE weight.fits
WEIGHT_GAIN Y
WEIGHT_THRESH

#-------------------------------- FLAGging -----------------------------------

FLAG_IMAGE flag.fits
FLAG_TYPE OR

#----------------------- Differential Geometry Map ---------------------------

DGEO_TYPE NONE
DGEO_IMAGE dgeo.fits

#------------------------------ Photometry -----------------------------------

PHOT_APERTURES 40.22, 56.31, 80.45
PHOT_AUTOPARAMS 2.5, 3.5
PHOT_PETROPARAMS 2.0, 3.5

PHOT_AUTOAPERS 0.0,0.0

PHOT_FLUXFRAC 0.2, 0.5, 0.8

SATUR_LEVEL 295977.
SATUR_KEY SATURATE

MAG_ZEROPOINT 30.
MAG_GAMMA 4.0
GAIN 6.11
GAIN_KEY GAIN
PIXEL_SCALE 0.3

#------------------------- Star/Galaxy Separation ----------------------------

SEEING_FWHM 1.2
STARNNW_NAME config/sextractor/default.nnw

#------------------------------ Background -----------------------------------

BACK_TYPE AUTO
BACK_VALUE 0.0
BACK_PEARSON 2.5

BACK_SIZE 32
BACK_FILTERSIZE 3

BACKPHOTO_TYPE GLOBAL
BACKPHOTO_THICK 24
BACK_FILTTHRESH 0.0

#------------------------------ Check Image ----------------------------------

CHECKIMAGE_TYPE BACKGROUND, BACKGROUND_RMS, MODELS, -MODELS, SEGMENTATION, FILTERED, -OBJECTS

CHECKIMAGE_NAME data/results_sex/check_bg.fits, data/results_sex/check_bgrms.fits, data/results_sex/check_mod.fits, data/results_sex/check_res.fits, data/results_sex/check_seg.fits, data/results_sex/check_fil.fits, data/results_sex/check_no_objs.fits

#--------------------- Memory (change with caution!) -------------------------

MEMORY_OBJSTACK 3000
MEMORY_PIXSTACK 300000
MEMORY_BUFSIZE 1024

#------------------------------- ASSOCiation ---------------------------------

ASSOC_NAME sky.list
ASSOC_DATA 2,3,4
ASSOC_PARAMS 2,3,4
ASSOCCOORD_TYPE PIXEL
ASSOC_RADIUS 2.0
ASSOC_TYPE NEAREST

ASSOCSELEC_TYPE MATCHED

#----------------------------- Miscellaneous ---------------------------------

VERBOSE_TYPE QUIETHEADER_SUFFIX .head
WRITE_XML N
XML_NAME data/results_sex/sex.xml
XSL_URL file:///usr/local/share/sextractor/sextractor.xsl

NTHREADS 1

FITS_UNSIGNED N
INTERP_MAXXLAG 16
INTERP_MAXYLAG 16
INTERP_TYPE ALL

#--------------------------- Experimental Stuff -----------------------------

PSF_NAME config/sextractor/my_prepsfex.psf
PSF_NMAX 1
PATTERN_TYPE RINGS-HARMONIC

SOM_NAME default.som
