# ========================================================
# Archivo de parametros para pset 'datapar.par'
# nombre,tipo,modo,valor_default,min,max,prompt
single,b,a,yes,,,                      enter 'no' if it's a list of images
pathname,s,a,"A496J.fits",,,           name of image or folder images
imagecut,r,h,100,30,300,               cutting (square) images in kpcs
initpos,s,a,"tables/inputlist.ascii",,,initial galaxy position table
cosmopar,s,a,"0.033 70 0.3 0.7",,,     Z H0 Omg_m Lamda (space separate!)
bcg_id,s,a,MCG_02_12_039,,,            id of center cluster
tformat,s,h,"ascii",,,                 format of initial pos. table
tcoord,s,h,"deg",,,                    only 'deg' or 'image'
# ========================================================
# Experimental Stuff
# sim_img,b,h,n,,,List of sky-simulated images?
# path_sim,f,h,"none",,,Name of the sky-sim img or folder
mode,s,h,al
# ========================================================
#
# --------------------------------------------------------
# VARIABLES (las siguientes lineas siempre comentadas):
#
# datapar.single
# datapar.pathname
# datapar.imagecut
# datapar.initpos
# datapar.cosmopar
# datapar.bcg_id
# datapar.tformat
# datapar.tcoord
# # datapar.sim_img
# # datapar.path_sim
#
